# Cloudflare Pages: pagina, service worker-ul și configurarea se iau mereu de la server (cache-ul doar pentru offline)
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/config.js
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
